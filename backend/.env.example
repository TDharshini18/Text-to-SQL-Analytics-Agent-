# Copy this file to .env and fill in your own values. Never commit .env.

# Required: Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here

# Optional: model name (default shown)
GROQ_MODEL=openai/gpt-oss-120b

# Optional: SQLite database path (default shown)
DB_PATH=data/sample.sqlite
